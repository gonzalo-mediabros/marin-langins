---
interface SocialLink {
  icon: string;
  href: string;
  label: string;
}

interface Props {
  logoSrc: string;
  logoAlt: string;
  copyright: string;
  socialLinks: SocialLink[];
}

const { logoSrc, logoAlt, copyright, socialLinks } = Astro.props;
---

<footer class="bg-surface py-8 border-t border-brand/10">
  <m-container>
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-col gap-2">
        <img src={logoSrc} alt={logoAlt} class="h-8 w-auto self-start" />
        <p class="text-sm text-gray-500" set:html={copyright}></p>
      </div>
      <ul class="flex gap-4 items-center">
        {socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener"
              aria-label={link.label}
              class="text-gray-400 hover:text-brand transition-colors"
            >
              <iconify-icon icon={link.icon} width="20" height="20"></iconify-icon>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </m-container>
</footer>
