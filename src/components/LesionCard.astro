---
interface Chip {
  label: string;
  href: string;
  srText?: string;
}

interface Props {
  id: string;
  emoji: string;
  titulo: string;
  descripcion: string;
  variant: "simple" | "chips";
  linkLabel?: string;
  linkHref?: string;
  chipsLabel?: string;
  chips?: Chip[];
}

const { id, emoji, titulo, descripcion, variant, linkLabel, linkHref, chipsLabel, chips } = Astro.props;
---

<div {id} class="flex items-start gap-4 rounded-2xl bg-surface p-6 shadow-lg">
  <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-gray-100 text-3xl">
    {emoji}
  </div>
  <div>
    <h3 class="text-xl font-bold text-brand">{titulo}</h3>
    <p class="mt-2 text-sm text-gray-600">{descripcion}</p>

    {variant === "simple" && linkHref && linkLabel && (
      <a
        href={linkHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-1.5 text-base font-bold text-cyan hover:text-cyan/80 cursor-pointer"
      >
        {linkLabel}
        <m-icon class="material-symbols-outlined text-base">arrow_forward</m-icon>
      </a>
    )}

    {variant === "chips" && chips && chips.length > 0 && (
      <>
        <p class="mt-3 text-base font-bold text-cyan">{chipsLabel}</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {chips.map((chip) => (
            <a
              href={chip.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-full border border-cyan/30 bg-cyan/5 px-3.5 py-1.5 text-sm font-bold text-cyan transition-all hover:border-cyan hover:bg-cyan hover:text-white"
            >
              {chip.label}
              <m-icon class="material-symbols-outlined" style="font-size:14px">arrow_forward</m-icon>
              {chip.srText && <span class="sr-only">{chip.srText}</span>}
            </a>
          ))}
        </div>
      </>
    )}
  </div>
</div>
