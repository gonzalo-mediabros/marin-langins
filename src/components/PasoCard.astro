---
interface Props {
  numero: number;
  titulo: string;
  descripcion: string;
  color?: "brand" | "cyan" | "rosa";
}

const { numero, titulo, descripcion, color } = Astro.props;

const getStepClass = () => {
  if (numero === 4) {
    return "mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-rosa text-2xl font-bold text-white shadow-md shadow-rosa/40";
  }
  const colorValue = color ?? "brand";
  const borderMap = {
    brand: "border-brand text-brand",
    cyan: "border-cyan text-cyan",
    rosa: "border-rosa text-rosa",
  };
  return `mb-6 flex h-16 w-16 items-center justify-center rounded-full border-2 ${borderMap[colorValue]} bg-surface text-2xl font-bold shadow-sm`;
};
---

<div class="relative flex flex-col items-center text-center">
  <div class={getStepClass()}>{numero}</div>
  <h3 class="mb-3 text-xl font-bold text-brand">{titulo}</h3>
  <p class="text-gray-600 text-balance">{descripcion}</p>
</div>
