---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import SectorCard from "../components/SectorCard.astro";
import PasoCard from "../components/PasoCard.astro";
import LesionesSection from "../components/LesionesSection.astro";
import FAQ from "../components/FAQ.astro";
import CTAFinal from "../components/CTAFinal.astro";
import Footer from "../components/Footer.astro";
import WAButton from "../components/WAButton.astro";
import Reviews from "../components/Reviews.astro";
---

<Layout
  title="Abogados Accidentes de Trabajo Comodoro Rivadavia | Consulta Gratis"
  description="¿Trabajás en petróleo, pesca o construcción en la Cuenca del Golfo San Jorge? Reclamá tu indemnización a la ART. Abogados en Comodoro Rivadavia y Caleta Olivia. Sin adelantos."
  canonical="https://marinpistachia.com/abogado-accidente-trabajo-comodoro-rivadavia/"
  ogImage="https://marinpistachia.com/abogado-accidente-trabajo-comodoro-rivadavia/imgs/marin-hero.webp"
  ogLocale="es_AR"
>
  <!-- Navbar -->
  <Navbar
    logoSrc="/abogado-accidente-trabajo-comodoro-rivadavia/imgs/logo-marin.webp"
    logoAlt="Marín Pistachia Abogados"
    waHref="https://wa.me/5492974166650?text=Quiero+saber+cu%C3%A1nto+me+corresponde"
  />

  <!-- Hero -->
  <Hero
    ciudad="Comodoro Rivadavia"
    h1="Accidente de trabajo en Comodoro Rivadavia"
    subtitulo="<strong>Te ayudamos a cobrar</strong> lo que te corresponde."
    intro="Somos abogados especialistas en accidentes laborales y reclamos a la ART, con oficina en Comodoro Rivadavia. Atendemos trabajadores de la industria petrolera, construcción, pesca, transporte y más en toda la Cuenca del Golfo San Jorge — Comodoro Rivadavia, Caleta Olivia, Rada Tilly, Sarmiento, Las Heras y zonas vecinas. <strong>Sin adelantos. Cobramos solo si ganás.</strong>"
    waHref="https://wa.me/5492974166650?text=Quiero+saber+cu%C3%A1nto+me+corresponde"
    calcHref="https://www.marinpistachia.com/calculadora-indemnizacion-accidente-trabajo/"
    heroImg="/abogado-accidente-trabajo-comodoro-rivadavia/imgs/marin-hero-sur.webp"
    heroImgAlt="Estudio de abogados en Comodoro Rivadavia"
    telefono="297 416-6650"
    telefonoHref="tel:2974166650"
    oficina="Fontana 1563, Comodoro Rivadavia (CP U9000) — Lun a Vie 9 a 18hs"
    trustItems={[
      "Consulta gratuita",
      "Sin adelantos",
      "Trabajo a resultado",
      "Oficina en Comodoro",
    ]}
  />

  <!-- Stats -->
  <Stats
    items={[
      {
        value: "+20",
        label: "Años de experiencia",
        target: 20,
        from: 0,
        prefix: "+",
      },
      { value: "0", label: "Adelantos requeridos", target: 0, from: 10 },
      { value: "5", label: "Ciudades en Argentina", target: 5, from: 0 },
      {
        value: "4.9",
        label: "Valoración en Google",
        target: 4.9,
        from: 4.0,
        decimals: 1,
        suffix: "star",
      },
    ]}
  />

  <!-- Sectores -->
  <section id="sectores" class="py-20 lg:py-28">
    <m-container>
      <div class="mb-16 max-w-3xl">
        <span class="text-sm font-bold text-cyan uppercase tracking-widest"
          >Sectores laborales en la región</span
        >
        <h2
          class="mt-4 text-3xl font-extrabold text-brand md:text-4xl lg:text-5xl uppercase tracking-wide"
        >
          Atendemos a trabajadores de todos los rubros de la Patagonia Austral
        </h2>
        <p class="mt-6 text-lg text-gray-600">
          La Cuenca del Golfo San Jorge concentra sectores de alto riesgo
          laboral. Si trabajás en petróleo, construcción, pesca, transporte o
          cualquier otro rubro y tuviste un accidente o enfermedad por tu
          trabajo, tenés derecho a reclamar una indemnización a la ART.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        <SectorCard
          icon="oil_barrel"
          titulo="Industria Petrolera y Gasífera"
          descripcion="Trabajadores de yacimientos, plataformas y refinerías de la Cuenca del Golfo San Jorge. Hernias de disco lumbar y cervical por vibración de maquinaria pesada, hipoacusia por ruido, lesiones de hombro (manguito rotador), accidentes con equipos de perforación y quemaduras por productos inflamables. Es el sector con mayor cantidad de reclamos y, por los altos salarios convencionales, también las indemnizaciones más significativas."
          zonas="Comodoro Rivadavia · Caleta Olivia · Rada Tilly · Cañadón Seco · Las Heras · Pico Truncado"
          href="https://www.marinpistachia.com/accidentado-trabajo-profesion/"
          color="brand"
        />
        <SectorCard
          icon="phishing"
          titulo="Pesca y Actividad Portuaria"
          descripcion="Marineros, estibadores, operarios de plantas pesqueras y procesadoras de la zona costera. Lesiones por esfuerzo repetitivo, aplastamientos, caídas a bordo, hipoacusia, dermatitis por contacto con productos químicos y patologías de columna por trabajo en condiciones extremas."
          zonas="Puerto Comodoro · Puerto Deseado · Puerto Caleta Paula"
          href="https://www.marinpistachia.com/accidentado-trabajo-profesion/"
          color="cyan"
        />
        <SectorCard
          icon="construction"
          titulo="Construcción"
          descripcion="Caídas desde altura, aplastamientos, fracturas de columna, pelvis y miembros, lesiones por carga y descarga de materiales. El sector tiene una de las tasas más altas de siniestralidad y los trabajadores accidentados acceden a indemnizaciones importantes."
          zonas="Comodoro Rivadavia · Caleta Olivia · Sarmiento"
          href="https://www.marinpistachia.com/accidentado-trabajo-profesion/"
          color="rosa"
        />
        <SectorCard
          icon="local_shipping"
          titulo="Transporte y Logística"
          descripcion="Camioneros con hernias de disco cervical y lumbar por vibración de cuerpo entero (Decreto 49/2014), accidentes de tránsito in itinere en la Ruta Nacional 3 y conexiones a yacimientos. Reclamos ante la ART y también contra aseguradoras del tercero responsable."
          zonas="Ruta Nacional 3 · Corredor patagónico · Accesos a yacimientos"
          href="https://www.marinpistachia.com/accidentado-trabajo-profesion/"
          color="brand"
        />
        <SectorCard
          icon="electric_bolt"
          titulo="Energía y Servicios Públicos"
          descripcion="Electricistas, técnicos de gas y trabajadores de servicios públicos expuestos a riesgos eléctricos, quemaduras y caídas. Accidentes con alta incapacidad residual."
          zonas="Energía · Gas · Agua"
          href="https://www.marinpistachia.com/accidentado-trabajo-profesion/"
          color="cyan"
        />
        <SectorCard
          icon="storefront"
          titulo="Comercio y Servicios"
          descripcion="Empleados de comercio, supermercados y servicios. Síndrome del túnel carpiano en cajeras, hernias de disco en repositores, lesiones de columna y enfermedades por esfuerzo repetitivo."
          zonas="Comodoro · Caleta Olivia · Rada Tilly"
          href="https://www.marinpistachia.com/accidentado-trabajo-profesion/"
          color="rosa"
        />
      </div>
    </m-container>
  </section>

  <!-- Comisiones Médicas -->
  <section id="comisiones-medicas" class="bg-surface py-20 lg:py-28">
    <m-container>
      <div class="mb-16 text-center">
        <span class="text-sm font-bold text-cyan uppercase tracking-widest"
          >Comisiones Médicas de la región</span
        >
        <h2
          class="mt-4 text-3xl font-extrabold text-brand md:text-4xl uppercase tracking-wide"
        >
          ¿Dónde se hacen los trámites <br class="hidden sm:block" /> ante la SRT
          en la Patagonia Austral?
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600">
          Para reclamar a la ART por un accidente o enfermedad profesional hay
          que presentarse ante la Comisión Médica de la SRT correspondiente a tu
          domicilio o lugar de trabajo.
        </p>
        <h4 class="mx-auto mt-4 max-w-2xl text-xl text-gray-600 font-bold">
          Estas son todas las comisiones de Chubut y Santa Cruz:
        </h4>
      </div>

      <!-- Chubut -->
      <div class="mb-12 rounded-2xl border border-azul/20 bg-azul/5 p-6 md:p-8">
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full bg-azul/10 px-4 py-1.5 text-base font-bold text-azul"
        >
          <m-icon class="material-symbols-outlined text-base">circle</m-icon> PROVINCIA
          DEL CHUBUT
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3
              class="text-xl font-extrabold text-brand flex items-center gap-1.5"
            >
              <m-icon class="material-symbols-outlined">location_on</m-icon> Comisión
              Médica Nº 19 — Comodoro Rivadavia
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p>
                <strong class="text-gray-800">Dirección:</strong> Rivadavia 827, Comodoro
                Rivadavia (U9000AKK)
              </p>
              <p>
                <strong class="text-gray-800">Horario:</strong> Lunes a viernes, 9
                a 14hs
              </p>
              <p>
                <strong class="text-gray-800">Competencia:</strong> Escalante, Río
                Senguer y Sarmiento
              </p>
            </div>
          </div>

          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3
              class="text-xl font-extrabold text-brand flex items-center gap-1.5"
            >
              <m-icon class="material-symbols-outlined"
                >subdirectory_arrow_right</m-icon
              > Delegación Esquel (CM 19)
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p>
                <strong class="text-gray-800">Dirección:</strong> Belgrano 542, Esquel
                (U9200BPL)
              </p>
              <p>
                <strong class="text-gray-800">Competencia:</strong> Futaleufu, Tehuelches,
                Languiñeo y Cushamen
              </p>
            </div>
          </div>

          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3
              class="text-xl font-extrabold text-brand flex items-center gap-1.5"
            >
              <m-icon class="material-symbols-outlined">location_on</m-icon> Comisión
              Médica Nº 36 — Trelew
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p>
                <strong class="text-gray-800">Dirección:</strong> Chile 65, Trelew
                (U9100HNI)
              </p>
              <p>
                <strong class="text-gray-800">Horario:</strong> Lunes a viernes, 8
                a 14hs
              </p>
              <p>
                <strong class="text-gray-800">Competencia:</strong> Viedma, Florentino
                Ameghino, Gaiman, Gastre, Martires, Paso de Indios, Rawson, Telsen
              </p>
            </div>
          </div>
        </div>

        <div
          class="mt-6 rounded-lg bg-azul/10 p-4 text-base font-medium text-azul"
        >
          💡 Chubut está adherida a la <strong>Ley 27.348</strong> — el paso por la
          Comisión Médica es obligatorio antes de iniciar una demanda judicial.
        </div>
      </div>

      <!-- Santa Cruz -->
      <div class="mb-12 rounded-2xl border border-rosa/20 bg-rosa/5 p-6 md:p-8">
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full bg-rosa/10 px-4 py-1.5 text-base font-bold text-rosa"
        >
          <m-icon class="material-symbols-outlined text-base">circle</m-icon> PROVINCIA
          DE SANTA CRUZ
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3
              class="text-xl font-extrabold text-brand flex items-center gap-1.5"
            >
              <m-icon class="material-symbols-outlined">location_on</m-icon> Comisión
              Médica Nº 20 — Río Gallegos
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p>
                <strong class="text-gray-800">Dirección:</strong> Perito Moreno 427,
                Río Gallegos (Z9403DDI)
              </p>
              <p>
                <strong class="text-gray-800">Horario:</strong> Lunes a viernes, 8
                a 13hs
              </p>
              <p>
                <strong class="text-gray-800">Competencia:</strong> Caleta Olivia,
                Cañadón Seco, Fitz Roy, Gdor. Moyano, Jaramillo, Kolver Kayke, Las
                Heras, Pico Truncado, Puerto Deseado y Tellier Los Antiguos y Perito
                Moreno.
              </p>
            </div>
          </div>

          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3
              class="text-xl font-extrabold text-brand flex items-center gap-1.5"
            >
              <m-icon class="material-symbols-outlined"
                >subdirectory_arrow_right</m-icon
              > Delegación Caleta Olivia (CM 20 delegación 2)
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p>
                <strong class="text-gray-800">Dirección:</strong> San José Obrero
                386, Caleta Olivia (Z9011HQH)
              </p>
              <p>
                <strong class="text-gray-800">Horario:</strong> Lunes a viernes, 8
                a 15hs · Demanda espontánea 8 a 12hs
              </p>
              <p>
                <strong class="text-gray-800">Competencia:</strong> Caleta Olivia,
                Cañadón Seco, Fitz Roy, Gdor. Moyano, Jaramillo, Kolver Kayke, Las
                Heras, Pico Truncado, Puerto Deseado y Tellier Los Antiguos y Perito
                Moreno.
              </p>
            </div>
          </div>
        </div>

        <div
          class="mt-6 rounded-lg bg-rosa/10 p-4 text-base font-medium text-rosa"
        >
          ⚠️ <strong
            >Dato clave para trabajadores de Santa Cruz: Importante —</strong
          > Santa Cruz NO está adherida a la Ley 27.348. Esto significa que en Santa
          Cruz <strong>el paso por la Comisión Médica no es obligatorio</strong> para
          los reclamos de ART: podés ir directamente a la Justicia laboral provincial.
          Es una ventaja procesal para los trabajadores santacruceños, ya que los
          porcentajes de incapacidad reconocidos por los peritos judiciales suelen
          ser más ajustados a lo que por ley corresponde.
        </div>
      </div>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="https://www.marinpistachia.com/comisiones-medicas-srt/"
          class="inline-flex items-center gap-2 rounded-lg bg-brand px-5 py-3 text-base font-bold text-white hover:bg-brand/90 transition-colors"
        >
          Ver listado completo de Comisiones Médicas →
        </a>
        <a
          href="https://www.marinpistachia.com/tramites-srt/"
          class="inline-flex items-center gap-2 rounded-lg bg-cyan px-5 py-3 text-base font-bold text-white hover:bg-cyan/90 transition-colors"
        >
          Ver guía de trámites ante la SRT →
        </a>
      </div>
    </m-container>
  </section>

  <!-- Proceso -->
  <section id="proceso" class="py-20 lg:py-28">
    <m-container>
      <div class="mb-16 text-center">
        <span class="text-sm font-bold text-cyan uppercase tracking-widest"
          >Cómo trabajamos</span
        >
        <h2
          class="mt-4 text-3xl font-extrabold text-brand md:text-4xl uppercase tracking-wide"
        >
          El proceso es simple. <br class="hidden sm:block" /> Nosotros nos encargamos
          de todo.
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600">
          Desde la primera consulta hasta que cobrás tu indemnización, te
          acompañamos en cada paso.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        <PasoCard
          numero={1}
          titulo="Consulta gratuita"
          descripcion="Analizamos tu caso sin costo. Por WhatsApp, teléfono o en nuestra oficina o por videollamada si sos de localidades alejadas de tu Comisión Médica. Te decimos si tenés derecho a cobrar y cuánto, sin compromiso."
          color="brand"
        />
        <PasoCard
          numero={2}
          titulo="Reclamo a la ART"
          descripcion="Presentamos el reclamo ante la Comisión Médica de Comodoro Rivadavia, Trelew, Esquel, Caleta Olivia y Río Gallegos con toda la documentación necesaria. Si vivís en localidades alejadas, gestionamos desde donde corresponda."
          color="cyan"
        />
        <PasoCard
          numero={3}
          titulo="Audiencia médica"
          descripcion="Te acompañamos a la junta médica para defender tu porcentaje de incapacidad real. Esta etapa es clave: la diferencia de solo 1% puede ser de millones."
          color="brand"
        />
        <PasoCard
          numero={4}
          titulo="Cobrás"
          descripcion="Una vez homologada la indemnización, cobrás directo en tu cuenta. Solo entonces cobramos honorarios. Sin adelantos, sin sorpresas."
          color="rosa"
        />
      </div>
    </m-container>
  </section>

  <!-- Lesiones -->
  <LesionesSection
    subtitulo="Lesiones y enfermedades más frecuentes"
    titulo="¿Cuánto podés cobrar por tu lesión?"
    descripcion="La indemnización depende de tu edad, sueldo y el porcentaje de incapacidad. Estas son las patologías más frecuentes que atendemos en Comodoro Rivadavia, Caleta Olivia y zona."
    lesiones={[
      {
        id: "hernia-disco",
        emoji: "🦴",
        titulo: "Hernia de disco",
        descripcion:
          "Muy frecuente en petroleros, camioneros y operarios de yacimiento. La ART suele rechazarla como 'degenerativa', pero con abogado se puede cobrar. El Decreto 49/2014 la reconoce expresamente como enfermedad profesional.",
        linkLabel: "Ver cuánto paga la ART",
        linkHref:
          "https://www.marinpistachia.com/news/accidentes-trabajo/art-hernia-disco/",
      },
      {
        id: "meniscos",
        emoji: "🦵",
        titulo: "Rotura de meniscos y ligamentos",
        descripcion:
          "Frecuente en trabajos en altura y superficies irregulares. Indemnizaciones muy alta según porcentaje, edad y profesiones relacionadas al petróleo, minería y pesca.",
        linkLabel: "Ver cuánto paga la ART",
        chips: [
          {
            label: "Meniscos",
            href: "https://www.marinpistachia.com/news/accidentes-trabajo/meniscos/",
            srText: " — Ver cuánto paga la ART por rotura de meniscos",
          },
          {
            label: "Ligamentos",
            href: "https://www.marinpistachia.com/news/accidentes-trabajo/rotura-ligamentos/",
            srText: " — Ver cuánto paga la ART por rotura de ligamentos",
          },
        ],
      },
      {
        id: "amputacion-dedos",
        emoji: "🤚",
        titulo: "Amputación de dedos",
        descripcion:
          "Muy común en maquinaria industrial y trabajos petroleros. Indemnizaciones elevadas según la cantidad de falanges perdidas y el dedo afectado (el pulgar paga más que el meñique).",
        linkLabel: "Ver cuánto paga la ART",
        linkHref:
          "https://www.marinpistachia.com/news/accidentes-trabajo/amputacion-dedo-art/",
      },
      {
        id: "manguito-rotador",
        emoji: "💪",
        titulo: "Manguito rotador",
        descripcion:
          "Lesión típica en trabajos con los brazos en alto y esfuerzos repetitivos. La ART intenta minimizar el porcentaje de incapacidad. Frecuente en sector petrolero y construcción.",
        linkLabel: "Ver cuánto paga la ART",
        linkHref:
          "https://www.marinpistachia.com/news/accidentes-trabajo/lesion-manguito-rotador/",
      },
      {
        id: "fracturas",
        emoji: "🦴",
        titulo: "Fracturas",
        descripcion:
          "Caídas desde altura, golpes con objetos o maquinaria. Fractura de rótula, fémur, húmero, pelvis y calcáneo. Frecuentes en construcción y yacimiento.",
        linkLabel: "Ver cuánto paga la ART",
        chips: [
          {
            label: "Tibia y peroné",
            href: "https://www.marinpistachia.com/news/accidentes-trabajo/fractura-tibia-perone/",
            srText: " — Ver cuánto paga la ART por fractura de tibia y peroné",
          },
          {
            label: "Radio",
            href: "https://www.marinpistachia.com/news/accidentes-trabajo/fractura-radio-art/",
            srText: " — Ver cuánto paga la ART por fractura de radio",
          },
          {
            label: "Cúbito",
            href: "https://www.marinpistachia.com/news/accidentes-trabajo/fractura-cubito/",
            srText: " — Ver cuánto paga la ART por fractura de cúbito",
          },
          {
            label: "Húmero",
            href: "https://www.marinpistachia.com/news/accidentes-trabajo/fractura-humero/",
