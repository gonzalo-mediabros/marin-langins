          },
        ],
      },
      {
        id: "lumbalgia",
        emoji: "🛌",
        titulo: "Lumbalgia y lumbociatalgia",
        descripcion:
          "Dolor lumbar crónico por esfuerzo laboral. Muy frecuente y habitualmente rechazado por la ART como 'preexistencia'. Con prueba médica adecuada y abogado, se reconoce.",
        linkLabel: "Ver cuánto paga la ART",
        linkHref:
          "https://www.marinpistachia.com/news/accidentes-trabajo/lumbociatalgia-indemnizacion-art/",
      },
    ]}
  />

  <!-- FAQ -->
  <FAQ
    items={[
