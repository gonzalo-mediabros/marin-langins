          },
          {
            label: "Calcáneo",
            href: "https://www.marinpistachia.com/news/accidentes-trabajo/fractura-de-calcaneo-cuanto-paga-la-art-2/",
            srText: " — Ver cuánto paga la ART por fractura de calcáneo",
          },
          {
            label: "Muñeca",
            href: "https://www.marinpistachia.com/news/accidentes-trabajo/indemnizacion-muneca/",
            srText: " — Ver cuánto paga la ART por fractura de muñeca",
          },
          {
            label: "Vértebra",
            href: "https://www.marinpistachia.com/news/accidentes-trabajo/fractura-vertebra/",
