  url: "https://www.marinpistachia.com/abogado-accidente-trabajo-neuquen/",
  telephone: "+5492994294696",
  image:
    "https://www.marinpistachia.com/abogado-accidente-trabajo-neuquen/imgs/logo-marin.webp",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Periodistas Neuquinos 308",
    addressLocality: "Neuquén",
    addressRegion: "Neuquén",
    addressCountry: "AR",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
