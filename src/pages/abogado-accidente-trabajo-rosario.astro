---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import SectorCard from "../components/SectorCard.astro";
import PasoCard from "../components/PasoCard.astro";
import LesionesSection from "../components/LesionesSection.astro";
import FAQ from "../components/FAQ.astro";
import CTAFinal from "../components/CTAFinal.astro";
import Footer from "../components/Footer.astro";
import WAButton from "../components/WAButton.astro";
---

<Layout
  title="Abogados Accidentes de Trabajo Rosario | Consulta Gratis"
  description="¿Sufriste un accidente laboral en el Gran Rosario? Reclamá la indemnización de tu ART con abogados especialistas. Oficina en Rosario, Santa Fe. Sin adelantos."
  canonical="https://marinpistachia.com/abogado-accidente-trabajo-rosario/"
  ogImage="https://marinpistachia.com/abogado-accidente-trabajo-rosario/imgs/marin-hero.jpg"
  ogLocale="es_AR"
>
  <!-- Navbar -->
  <Navbar
    logoSrc="/abogado-accidente-trabajo-rosario/imgs/logo-marin.png"
    logoAlt="Marín Pistachia Abogados"
    waHref="https://wa.me/5493412255968?text=Quiero+saber+cu%C3%A1nto+me+corresponde"
  />

  <!-- Hero -->
  <Hero
    ciudad="Rosario"
    h1="Accidente de trabajo en Rosario"
    subtitulo="<strong>Te ayudamos a cobrar</strong> lo que te corresponde."
    intro="Somos abogados especialistas en accidentes laborales y reclamos a la ART, con oficina en Rosario. Atendemos trabajadores de la industria, comercio, transporte, agro y salud en todo el Gran Rosario y sur de Santa Fe — desde Cañada de Gómez hasta Villa Constitución, San Lorenzo, Pérez y Funes. <strong>Sin adelantos. Cobramos solo si ganás.</strong>"
    waHref="https://wa.me/5493412255968?text=Quiero+saber+cu%C3%A1nto+me+corresponde"
    calcHref="https://www.marinpistachia.com/calculadora-indemnizacion-accidente-trabajo/"
    heroImg="/abogado-accidente-trabajo-rosario/imgs/marin-hero.jpg"
    heroImgAlt="Estudio de abogados en Rosario"
    telefono="341 225-5968"
    telefonoHref="tel:3412255968"
    oficina="Rosario, Santa Fe — Lun a Vie 9 a 18hs"
    trustItems={[
      "Consulta gratuita",
      "Sin adelantos",
      "Trabajo a resultado",
      "Oficina en Rosario",
    ]}
  />

  <!-- Stats -->
  <Stats
    items={[
      {
        value: "+20",
        label: "Años de experiencia",
        target: 20,
        from: 0,
        prefix: "+",
      },
      { value: "0", label: "Adelantos requeridos", target: 0, from: 10 },
      { value: "5", label: "Ciudades en Argentina", target: 5, from: 0 },
      {
        value: "4.9",
        label: "Valoración en Google",
        target: 4.9,
        from: 4.0,
        decimals: 1,
        suffix: "star",
      },
    ]}
  />

  <!-- Sectores -->
  <section id="sectores" class="py-20 lg:py-28">
    <m-container>
      <div class="mb-16 max-w-3xl">
        <span class="text-sm font-bold text-cyan uppercase tracking-widest"
          >Sectores laborales en Rosario</span
        >
        <h2
          class="mt-4 text-3xl font-extrabold text-brand md:text-4xl lg:text-5xl uppercase tracking-wide"
        >
          Atendemos a trabajadores de todos los rubros del Gran Rosario
        </h2>
        <p class="mt-6 text-lg text-gray-600">
          Rosario concentra una de las economías más diversificadas del país:
          industria, agro, comercio, salud, transporte y servicios. Si trabajás
          en cualquiera de estos rubros y tuviste un accidente o enfermedad por
          tu trabajo, tenés derecho a reclamar una indemnización a la ART.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        <SectorCard
          icon="factory"
          titulo="Industria y Manufactura"
          descripcion="Operarios de plantas industriales, metalúrgicas, frigoríficos y aceiteras del cordón industrial. Amputaciones por maquinaria, hipoacusia por ruido, hernias de disco en líneas de producción y enfermedades respiratorias por exposición a polvos y químicos. El cinturón industrial Rosario–San Lorenzo–San Martín concentra una de las mayores siniestralidades del país."
          zonas="San Lorenzo · Capitán Bermúdez · Granadero Baigorria · Pérez · Funes"
          href="https://www.marinpistachia.com/accidentes-por-profesion/"
          color="brand"
        />
        <SectorCard
          icon="agriculture"
          titulo="Agro y Agroindustria"
          descripcion="Peones rurales, operarios de silos, plantas aceiteras, harineras y exportadoras. Accidentes con maquinaria agrícola, lesiones por carga de mercadería, hernias de disco por vibración de cuerpo entero, exposición a productos agroquímicos. Indemnizaciones por enfermedades profesionales del agro habitualmente rechazadas por la ART."
          zonas="Cañada de Gómez · Casilda · Venado Tuerto · Firmat · Sur de Santa Fe"
          href="https://www.marinpistachia.com/accidentes-por-profesion/"
          color="cyan"
        />
        <SectorCard
          icon="local_shipping"
          titulo="Transporte y Logística"
          descripcion="Camioneros de larga distancia con hernias de disco cervical y lumbar (Decreto 49/2014 las reconoce expresamente como enfermedad profesional). Choferes de colectivo, taxi y transporte urbano. Accidentes in itinere en accesos a la ciudad y autopista. Reclamos paralelos a ART y a aseguradoras de tránsito."
          zonas="AU Rosario–BsAs · Acceso norte · Acceso sur · Circunvalación"
          href="https://www.marinpistachia.com/accidentes-por-profesion/"
          color="rosa"
        />
        <SectorCard
          icon="storefront"
          titulo="Comercio y Supermercados"
          descripcion="Empleados de comercio, cadenas de supermercados, depósitos y logística. Síndrome del túnel carpiano en cajeras, hernias de disco en repositores, lumbalgia crónica en personal de depósito, lesiones en hombro por tareas repetitivas."
          zonas="Centro · Pichincha · Echesortu · La Florida · zona sur"
          href="https://www.marinpistachia.com/accidentes-por-profesion/"
          color="brand"
        />
        <SectorCard
          icon="construction"
          titulo="Construcción"
          descripcion="Caídas desde altura, aplastamientos, fracturas de columna, pelvis y miembros. Alta siniestralidad y derecho a indemnizaciones importantes."
          zonas="Gran Rosario · zona Puerto Norte · barrios en crecimiento"
          href="https://www.marinpistachia.com/accidentes-por-profesion/"
          color="cyan"
        />
        <SectorCard
          icon="local_hospital"
          titulo="Salud y Educación"
          descripcion="Enfermeros y kinesiólogos con lesiones de columna por movilización de pacientes. Médicos y odontólogos con patologías cervicales por postura. Docentes con nódulos vocales y patologías de columna. Exposición a agentes biológicos en sector salud."
          zonas="Hospitales públicos · Clínicas privadas · Escuelas y nivel terciario"
          href="https://www.marinpistachia.com/accidentes-por-profesion/"
          color="rosa"
        />
      </div>
    </m-container>
  </section>

  <!-- Comisiones Médicas -->
  <section id="comisiones-medicas" class="bg-surface py-20 lg:py-28">
    <m-container>
      <div class="mb-16 text-center">
        <span class="text-sm font-bold text-cyan uppercase tracking-widest"
          >COMISIONES MÉDICAS Rosario y Zona</span
        >
        <h2
          class="mt-4 text-3xl font-extrabold text-brand md:text-4xl uppercase tracking-wide"
        >
          ¿DÓNDE SE HACEN LOS TRÁMITES <br class="hidden sm:block" /> ANTE LA SRT
          EN rosario y zona de influencia?
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600">
          Para reclamar a la ART por un accidente o enfermedad profesional hay
          que presentarse ante la Comisión Médica de la SRT correspondiente a tu
          domicilio o lugar de trabajo.
        </p>
        <h4 class="mx-auto mt-4 max-w-2xl text-xl text-gray-600 font-bold">
          Estas son todas las comisiones médicas y delegaciones de la provincia
          de Santa Fe:
        </h4>
      </div>

      <!-- Jurisdicción Rosario CM 7 -->
      <div
        class="mb-12 rounded-2xl border border-brand/20 bg-brand/5 p-6 md:p-8"
      >
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full bg-brand/10 px-4 py-1.5 text-base font-bold text-brand"
        >
          <m-icon class="material-symbols-outlined text-base">circle</m-icon> JURISDICCIÓN
          ROSARIO (CM 7)
        </div>

        <div class="mb-6">
          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3
              class="text-xl font-extrabold text-brand flex items-center gap-1.5"
            >
              <m-icon class="material-symbols-outlined">location_on</m-icon> Comisión
              Médica Nº 7 — Rosario
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p>
                <strong class="text-gray-800">Dirección:</strong> Salta 2602, Rosario,
                Santa Fe
              </p>
              <p>
                <strong class="text-gray-800">Horario:</strong> Lunes a viernes, 8
                a 15hs
              </p>
              <p>
                <strong class="text-gray-800">Sub-comisiones:</strong> CM 7 A, 7 B,
                7 C y 7 D (todas en la misma sede)
              </p>
              <p>
                <strong class="text-gray-800">Competencia:</strong> Arroyo Seco, Cañada
                de Gomez, Casilda, Granadero Baigorria, Las Rosas, San Lorenzo, Villa
                Constitución y Villa Gobernador Galvez. — tramita más del 73% de los
                expedientes de la provincia
              </p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3
              class="text-xl font-extrabold text-brand flex items-center gap-1.5"
            >
              <m-icon class="material-symbols-outlined">location_on</m-icon> ROSARIO
              - Anexo Rosario
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p>
                <strong class="text-gray-800">Dirección:</strong> Presidente Roca
                1015 (S2000CXU) - Rosario.
              </p>
              <p>
                <strong class="text-gray-800">Horario:</strong> 8 a 15hs.
              </p>
            </div>
          </div>

          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3
              class="text-xl font-extrabold text-brand flex items-center gap-1.5"
            >
              <m-icon class="material-symbols-outlined">location_on</m-icon> Mesa
              de Entradas en Tribunales de Rosario
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p>
                <strong class="text-gray-800">Dirección:</strong> Balcarce 1651, 2º
                piso (edificio Tribunales), Rosario
              </p>
              <p>
                <strong class="text-gray-800">Horario:</strong> Lunes a viernes, 8
                a 15hs — atendida por el Colegio de Abogados de Rosario
              </p>
            </div>
          </div>

          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3
              class="text-xl font-extrabold text-brand flex items-center gap-1.5"
            >
              <m-icon class="material-symbols-outlined">location_on</m-icon> Delegación
              San Lorenzo (CM 7)
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p>
                <strong class="text-gray-800">Competencia:</strong> mismas circunscripciones
                que CM 7 — cubre el cordón industrial Rosario–San Lorenzo
              </p>
            </div>
          </div>

          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3
              class="text-xl font-extrabold text-brand flex items-center gap-1.5"
            >
              <m-icon class="material-symbols-outlined">location_on</m-icon> Delegación
              Venado Tuerto (CM 7)
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p>
                <strong class="text-gray-800">Dirección:</strong> Av. España 504,
                Venado Tuerto
              </p>
              <p>
                <strong class="text-gray-800">Competencia:</strong> circunscripción
                judicial Nº 3 "Venado Tuerto"
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- JURISDICCIÓN SANTA FE CAPITAL (CM 40) - comentado por feedback del cliente
      <div class="mb-12 rounded-2xl border border-cyan/20 bg-cyan/5 p-6 md:p-8">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-cyan/10 px-4 py-1.5 text-base font-bold text-cyan">
          <m-icon class="material-symbols-outlined text-base">circle</m-icon> JURISDICCIÓN SANTA FE CAPITAL (CM 40)
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3 class="text-xl font-extrabold text-brand flex items-center gap-1.5">
              <m-icon class="material-symbols-outlined">location_on</m-icon> Comisión Médica Nº 40 — Santa Fe Capital
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p><strong class="text-gray-800">Dirección:</strong> Las Heras 2883, Santa Fe Capital</p>
              <p><strong class="text-gray-800">Horario:</strong> Lunes a viernes, 8 a 15hs · Demanda espontánea 8 a 12hs</p>
              <p><strong class="text-gray-800">Competencia:</strong> circunscripción judicial Nº 1 "Santa Fe"</p>
            </div>
          </div>
          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3 class="text-xl font-extrabold text-brand flex items-center gap-1.5">
              <m-icon class="material-symbols-outlined">location_on</m-icon> Delegación Reconquista (CM 40)
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p><strong class="text-gray-800">Dirección:</strong> Av. España 504 esq. Ludueña, Reconquista</p>
              <p><strong class="text-gray-800">Competencia:</strong> circunscripción Nº 4 "Reconquista" (Vera, Villa Ocampo, Las Toscas)</p>
            </div>
          </div>
          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3 class="text-xl font-extrabold text-brand flex items-center gap-1.5">
              <m-icon class="material-symbols-outlined">location_on</m-icon> Delegación Rafaela (CM 40)
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p><strong class="text-gray-800">Dirección:</strong> Las Heras 2883, Rafaela</p>
              <p><strong class="text-gray-800">Competencia:</strong> circunscripción Nº 5 "Rafaela"</p>
            </div>
          </div>
          <div class="rounded-xl border border-white bg-white p-5 shadow-sm">
            <h3 class="text-xl font-extrabold text-brand flex items-center gap-1.5">
              <m-icon class="material-symbols-outlined">location_on</m-icon> Delegación Sunchales (CM 40)
            </h3>
            <div class="mt-3 space-y-2 text-base text-gray-600">
              <p><strong class="text-gray-800">Dirección:</strong> San Martín 1022, Sunchales</p>
              <p><strong class="text-gray-800">Competencia:</strong> parte de la circunscripción Nº 5 "Rafaela"</p>
            </div>
          </div>
        </div>
      </div>
      -->

      <div
        class="mt-4 rounded-lg bg-cyan/10 p-4 text-base font-medium text-cyan text-center max-w-2xl mx-auto mb-12"
      >
        💡 Santa Fe está adherida a la <strong>Ley 27.348</strong> (Ley provincial
        14.003) — el paso por la Comisión Médica es obligatorio antes de iniciar una
        demanda judicial en casos de accidentes de trabajo con incapacidad permanente.
      </div>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="https://www.marinpistachia.com/comisiones-medicas-srt/"
          class="inline-flex items-center gap-2 rounded-lg bg-brand px-5 py-3 text-base font-bold text-white hover:bg-brand/90 transition-colors"
        >
          Ver listado completo de Comisiones Médicas →
        </a>
        <a
          href="https://www.marinpistachia.com/tramites-srt/"
          class="inline-flex items-center gap-2 rounded-lg bg-cyan px-5 py-3 text-base font-bold text-white hover:bg-cyan/90 transition-colors"
        >
          Ver guía de trámites ante la SRT →
        </a>
      </div>
    </m-container>
  </section>

  <!-- Proceso -->
  <section id="proceso" class="py-20 lg:py-28">
    <m-container>
      <div class="mb-16 text-center">
        <span class="text-sm font-bold text-cyan uppercase tracking-widest"
          >Cómo trabajamos</span
        >
        <h2
          class="mt-4 text-3xl font-extrabold text-brand md:text-4xl uppercase tracking-wide"
        >
          El proceso es simple. <br class="hidden sm:block" /> Nosotros nos encargamos
          de todo.
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600">
          Desde la primera consulta hasta que cobrás tu indemnización, te
          acompañamos en cada paso.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        <PasoCard
          numero={1}
          titulo="Consulta gratuita"
          descripcion="Analizamos tu caso sin costo. Por WhatsApp, teléfono o en nuestra oficina de Rosario. Te decimos si tenés derecho a cobrar y cuánto, sin compromiso."
          color="brand"
        />
        <PasoCard
          numero={2}
          titulo="Reclamo a la ART"
           descripcion="Presentamos el reclamo ante la Comisión Médica Nro. 7 de Rosario con toda la documentación necesaria. Si vivís en Villa Gobernador Gálvez, Arroyo Seco, Villa Constitución, San Lorenzo, Timbúes, Puerto Gral. San Martín, Fray Luis Beltrán, Capitán Bermúdez, gestionamos desde donde corresponda y nos ocupamos de tus traslados."
          color="cyan"
        />
        <PasoCard
          numero={3}
          titulo="Audiencia médica"
           descripcion="Te acompañamos a la junta médica para defender tu porcentaje de incapacidad real. Esta etapa es clave: la diferencia de solo 1% puede ser de millones."
          color="brand"
        />
        <PasoCard
          numero={4}
          titulo="Cobrás"
          descripcion="Una vez homologada la indemnización, cobrás directo en tu cuenta. Solo entonces cobramos honorarios. Sin adelantos, sin sorpresas."
          color="rosa"
        />
      </div>
    </m-container>
  </section>

  <!-- Lesiones -->
  <LesionesSection
    subtitulo="Lesiones y enfermedades más frecuentes"
    titulo="¿Cuánto podés cobrar por tu lesión?"
    descripcion="La indemnización depende de tu edad, sueldo y el porcentaje de incapacidad. Estas son las patologías más frecuentes que atendemos en Rosario y el Gran Rosario."
    lesiones={[
      {
        id: "hernia-disco",
        emoji: "💥",
        titulo: "Hernia de disco",
        descripcion:
          "Muy frecuente en camioneros, operarios industriales y empleados de comercio. La ART suele rechazarla como 'degenerativa', pero con abogado y peritaje médico se reconoce.",
        linkLabel: "Ver cuánto paga la ART",
        linkHref:
          "https://www.marinpistachia.com/news/accidentes-trabajo/art-hernia-disco/",
      },
      {
        id: "tunel-carpiano",
        emoji: "🤚",
        titulo: "Síndrome del túnel carpiano",
        descripcion:
          "Muy común en cajeras, operarios de líneas de producción y trabajadores con tareas manuales repetitivas. Frecuente en comercio, supermercados e industria.",
        linkLabel: "Ver cuánto paga la ART",
        linkHref:
          "https://www.marinpistachia.com/news/accidentes-trabajo/sindrome-tunel-carpiano/",
      },
      {
        id: "manguito-rotador",
        emoji: "💪",
        titulo: "Manguito rotador",
        descripcion:
          "Lesión típica de operarios industriales, mecánicos y trabajadores con esfuerzos en altura. La ART minimiza el porcentaje; con abogado se reconoce lo que corresponde.",
        linkLabel: "Ver cuánto paga la ART",
        linkHref:
          "https://www.marinpistachia.com/news/accidentes-trabajo/lesion-manguito-rotador/",
      },
      {
        id: "amputacion-dedos",
        emoji: "✋",
        titulo: "Amputación de dedos",
        descripcion:
          "Muy frecuente en metalurgia y maquinaria industrial del cordón Rosario–San Lorenzo. Indemnizaciones elevadas según la cantidad de falanges y el dedo afectado.",
        linkLabel: "Ver cuánto paga la ART",
        linkHref:
          "https://www.marinpistachia.com/news/accidentes-trabajo/amputacion-dedo-art/",
      },
      {
        id: "fracturas",
        emoji: "🦴",
        titulo: "Fracturas",
        descripcion:
          "Caídas, golpes con objetos o maquinaria. Fractura de rótula, fémur, húmero, pelvis, calcáneo y vértebras. Frecuentes en construcción e industria.",
